# Default number of objects per page
PER_PAGE = 10

# Django Secret Key (gere uma aleatória e nunca a publique):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY = 'Change-ME'

# 0 = False - 1 = True
DEBUG = 0

# 1 = sistema publicado atrás de HTTPS (cookies seguros, redirect, HSTS)
USE_HTTPS = 0
# 1 = um proxy (nginx etc.) termina o HTTPS e repassa X-Forwarded-Proto
BEHIND_HTTPS_PROXY = 0

# 0 = False - 1 = True
SELENIUM_HEADLESS = 0

# Database settings
#SQlite
DATABASE_ENGINE = 'django.db.backends.sqlite3'
DATABASE_NAME = './db.sqlite3'

