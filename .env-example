# Copie este arquivo para .env e ajuste os valores.
# Toda variável aqui é lida pelo rh/settings.py; as que ficarem de fora
# usam o valor padrão indicado no comentário.

# Django Secret Key (gere uma aleatória e nunca a publique):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY = 'Change-ME'

# 0 = False - 1 = True
DEBUG = 0

# Domínios/IPs que podem acessar o sistema, separados por vírgula
ALLOWED_HOSTS = 'localhost,127.0.0.1'
# Origens confiáveis para o CSRF (com http:// ou https://), separadas por vírgula
CSRF_TRUSTED_ORIGINS = 'http://127.0.0.1'

# 1 = sistema publicado atrás de HTTPS (cookies seguros, redirect, HSTS)
USE_HTTPS = 0
# 1 = um proxy (nginx etc.) termina o HTTPS e repassa X-Forwarded-Proto
BEHIND_HTTPS_PROXY = 0
# Tempo do HSTS em segundos (só vale com USE_HTTPS=1). Padrão: 1 ano
# SECURE_HSTS_SECONDS = 31536000

# Endereço do painel admin do Django. Padrão: admin/
# Em produção, prefira um caminho difícil de adivinhar.
# ADMIN_URL = 'painel-troque-isto/'

# Nível dos logs do app rhcontrol. Padrão: DEBUG se DEBUG=1, senão INFO
# LOG_LEVEL = 'INFO'

# Pasta onde ficam os arquivos enviados (listas de presença escaneadas etc.).
# Padrão: a pasta media/ dentro do projeto. Em produção, use uma pasta fora
# do código, com escrita para o usuário do Gunicorn, e inclua-a no backup.
# MEDIA_ROOT = '/srv/rh/media'

# Database settings
#SQlite
DATABASE_ENGINE = 'django.db.backends.sqlite3'
DATABASE_NAME = './db.sqlite3'

# PostgreS
# DATABASE_ENGINE = 'django.db.backends.postgresql'
# DATABASE_NAME = 'basededados'

DATABASE_USER = "usuario"
DATABASE_PASSWORD = "senha"
DATABASE_HOST = "127.0.0.1"
DATABASE_PORT = "5432"

# E-mail (notificações). Para desenvolvimento, imprimir no terminal:
# EMAIL_BACKEND = 'django.core.mail.backends.console.EmailBackend'
EMAIL_BACKEND = 'django.core.mail.backends.smtp.EmailBackend'
EMAIL_HOST = 'localhost'
EMAIL_PORT = 25
# true/false
EMAIL_USE_TLS = 'false'
EMAIL_HOST_USER = ''
EMAIL_HOST_PASSWORD = ''
DEFAULT_FROM_EMAIL = 'webmaster@localhost'

# Dados da empresa (cabeçalhos, rodapés e PDFs). Os valores abaixo são
# genéricos, de demonstração; os reais ficam só no .env de produção.
COMPANY_NAME = 'RH SYSTEM DEMO'
COMPANY_CNPJ = '00.000.000/0001-00'
COMPANY_ADDRESS = 'Rua de Teste, 123'
COMPANY_NEIGHBORHOOD = 'Bairro Demo'
COMPANY_CITY = 'Cidade'
COMPANY_STATE = 'UF'
COMPANY_ZIP = '00000-000'
COMPANY_PHONE = '(11) 9999-9999'
COMPANY_EMAIL = 'contato@demo.com.br'
COMPANY_AGENCY = 'Agência de RH Demo'
